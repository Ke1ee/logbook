{
  "name": "logbook",
  "version": "0.1.0",
  "private": true,
  "description": "A local macOS app that turns your coding agents' session transcripts into an understanding of your own systems.",
  "type": "module",
  "scripts": {
    "sync": "electrobun sync",
    "app": "electrobun dev",
    "dev": "electrobun dev --watch",
    "build": "electrobun build --env=stable",
    "ingest": "bun run src/cli/logbook.ts ingest",
    "watch": "bun run src/cli/logbook.ts ingest --watch",
    "stats": "bun run src/cli/logbook.ts stats",
    "test": "bun test",
    "typecheck": "tsc --noEmit -p tsconfig.core.json && tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@types/bun": "1.3.12",
    "electrobun": "2.0.5",
    "typescript": "7.0.2"
  }
}
